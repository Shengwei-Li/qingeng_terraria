	SwordImmortalHat: {
		DisplayName: 青衣剑仙的斗笠
		// Tooltip: ""
	}

	CloudweaveSilk: {
		DisplayName: 云纹绡
		Tooltip: 用来制作青衫套装
	}

	AzureWayfarerRobe: {
		DisplayName: 青衫·剑袍
		Tooltip: 近战伤害 +8%，近战暴击率 +8%
		SetBonus:
			'''
			身法：双击左或右方向键冲刺，冲刺开始时短暂无敌
			剑意：剑类武器每次命中叠 1 层，最多 5 层；每层剑类伤害 +4%、攻速 +3%；3 秒不命中则清空
			同时戴着青衫·发冠时获得罡气护体：受到伤害后 4 把小剑环绕 3 秒，期间受到伤害 -25%，碰到的敌人会受伤；冷却 20 秒
			'''
	}

	AzureWayfarerCrown: {
		DisplayName: 青衫·发冠
		Tooltip:
			'''
			近战暴击率 +6%
			与青衫·剑袍、青衫·云履一起穿戴时获得罡气护体
			'''
	}

	AzureWayfarerBoots: {
		DisplayName: 青衫·云履
		Tooltip: 移动速度 +10%，近战攻速 +10%
	}

	InkwakeTassel: {
		DisplayName: 剑穗
		Tooltip:
			'''
			剑类武器伤害 +15%，暴击率 +10%
			剑类武器暴击时在敌人身上留下墨痕，1 秒后爆开，造成这次伤害的一半
			'''
	}

	AzureCloudDraught: {
		DisplayName: 青云药酒
		Tooltip:
			'''
			回复 200 生命值
			获得微醺 5 分钟
			'''
	}

	LitanyOfSwordflight: {
		DisplayName: 腾云诀
		Tooltip: 召唤可乘坐的云：无限飞行，不受摔落伤害
	}

	LingeringStreamTalisman: {
		DisplayName: 清流剑符
		Tooltip:
			'''
			朝鼠标方向放出一道剑河，最多命中 12 个敌人，对 Boss 伤害 -30%
			放出时无敌 1 秒，每 6 秒最多触发一次
			'''
	}

	Swordborne: {
		DisplayName: 御剑
		Tooltip:
			'''
			脚踏飞剑飞行，飞行时间 2.5 秒
			按住下和跳跃可以悬停，悬停时飞行时间消耗加倍
			'''
	}

	Clearmoon: {
		DisplayName: 清月剑
		Tooltip:
			'''
			三段连击：横扫、回撩各放出一道剑气；第三段前刺放出长剑气，命中的敌人 0.3 秒后再受到一次斩击
			右键：剑飞到鼠标处连斩三次后飞回，冷却 2.5 秒；剑不在手中时无法攻击
			'''
	}

	CloudbrewGourd: {
		DisplayName: 一壶酒
		RecipeCondition: 击败过青衣剑仙
		Tooltip:
			'''
			召唤青衣剑仙挑战，消耗一壶
			困难模式之前只能召来饮酒的他，无法挑战，也不消耗
			'''
	}
}

