NPCs: {
	SwordImmortal: {
		DisplayName: 青衣剑仙
		Pursue: 想走？剑会追上你。
		Defeat: 改日再来。
		PhaseTwo: 且看我剑意。
		PhaseThree: 此间天地，唯剑而已。
		FinalStroke: 最后一剑。
		Unbound: 剑气，纵横。
		Drink: 且饮一杯。
		Reclaim: 拿我的剑来问我？
		ReturnBlade: 剑还你。
		BladeAnswers: 以剑问剑，善。
		Again: 又是你。
		Received: 这一剑，你接住了。
		Farewell: 后会有期。
	}

	FinalSword.DisplayName: 最后一剑

	WanderingImmortal: {
		DisplayName: 青衣剑仙
		Arrive: 青衣剑仙在附近的云上饮酒。
		Disturb: 莫扰我喝酒。
		Oh: 哦？
		Accept: 好，陪你走几招。
		Dismiss1: 回去再练练。
		Dismiss2: 不知进退。
		Dismiss3: ……
		Leave: 天色晚了。
		Gone: 青衣剑仙走了。
	}
}

