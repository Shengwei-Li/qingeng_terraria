		DisplayName: 青衣剑仙遗物
		// Tooltip: ""
	}

	SwordImmortalMask: {
		DisplayName: 青衣剑仙面具
		// Tooltip: ""
	}

	CloudweaveSilk: {
		DisplayName: 云纹绡
		Tooltip: 剑仙衣袂间的仙气，凝成一匹轻绡
	}

	AzureWayfarerRobe: {
		DisplayName: 青衫·剑袍
		Tooltip: 近战伤害 +8%，近战暴击率 +8%
		SetBonus:
			'''
			身法：双击左右方向键，踏云冲刺，起步一瞬无敌
			剑意：剑类命中叠一层剑意，最多 5 层，每层剑类伤害 +4%、攻速 +3%；三秒不出剑便散
			再戴上青衫·发冠——罡气护体：受击后四柄小青剑绕身三秒，期间受到伤害 -25%，碰到的敌人会被斩伤；冷却 20 秒
			'''
	}

	AzureWayfarerCrown: {
		DisplayName: 青衫·发冠
		Tooltip:
			'''
			近战暴击率 +6%
			与青衫剑袍、云履同穿时解锁罡气护体
			'''
	}

	AzureWayfarerBoots: {
		DisplayName: 青衫·云履
		Tooltip: 移动速度 +10%，近战攻速 +10%
	}

	InkwakeTassel: {
		DisplayName: 剑穗
		Tooltip:
			'''
			剑类武器伤害 +15%，暴击率 +10%
			剑类暴击时留下墨痕，一秒后炸开，追加这一击一半的伤害
			'''
	}

	AzureCloudDraught: {
		DisplayName: 青云药酒
		Tooltip:
			'''
			剑仙的疗伤药酒，一口下去，伤去大半
			饮后微醺五分钟
			'''
	}

	LitanyOfSwordflight: {
		DisplayName: 御剑诀
		Tooltip: 念一句口诀，脚下生云
	}

	Clearmoon: {
		DisplayName: 清月剑
		Tooltip:
			'''
			三段连斩：上挑、下劈、旋身一斩并甩出月牙剑气
			剑仙所赠。清辉一线，锋不染尘
			'''
	}

	CloudbrewGourd: {
		DisplayName: 一壶酒
		RecipeCondition: 已与剑仙问剑
		Tooltip:
			'''
			倒一杯敬天，剑仙乘云而来
			（未曾问剑时，请来的是云上饮酒的他）
			'''
	}
}

