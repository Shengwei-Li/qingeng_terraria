NPCs: {
	SwordImmortal: {
		DisplayName: 青衣剑仙
		Pursue: 避战者，剑必至。
		Defeat: 剑心未定，改日再来。
		PhaseTwo: 且看我剑意。
		PhaseThree: 此间天地，唯剑而已。
		FinalStroke: 最后一剑。
		Unbound: 剑气，纵横。
		Drink: 且饮一杯。
		Reclaim: 拿我的剑来问我？
		ReturnBlade: 剑还你。好生用。
		BladeAnswers: 以剑问剑，善。
		Again: 又是你。
		Received: 这一剑，你接住了。
		Farewell: 青山不改，后会有期。
	}

	FinalSword.DisplayName: 最后一剑

	WanderingImmortal: {
		DisplayName: 青衣剑仙
		Arrive: 一缕酒香随风飘来……
		Disturb: 小友，莫扰我酒兴。
		Oh: 哦？
		Accept: 好，陪你走几招。
		Dismiss1: 回去再练练。
		Dismiss2: 不知进退。
		Dismiss3: ……
		Leave: 天色晚了。
		Gone: 酒尽，人去。
	}
}

Items: {
	SwordImmortalBag: {
		DisplayName: 宝藏袋（青衣剑仙）
		Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
	}

	SwordImmortalTrophy: {
		DisplayName: 青衣剑仙纪念杯
