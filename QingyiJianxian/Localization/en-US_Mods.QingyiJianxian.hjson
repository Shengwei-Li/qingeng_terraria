NPCs: {
	SwordImmortal: {
		DisplayName: The Azure-Clad Sword Immortal
		Pursue: Running? The sword will follow.
		Defeat: Come back another day.
		PhaseTwo: Now, my sword-will.
		PhaseThree: In this world, there is only the sword.
		FinalStroke: The final stroke.
		Unbound: Sword-will, unbound.
		Drink: One cup first.
		Reclaim: You'd test me with my own sword?
		ReturnBlade: Your sword, back.
		BladeAnswers: Blade for blade. Good.
		Again: You again.
		Received: You took that stroke.
		Farewell: Until we meet again.
	}

	FinalSword.DisplayName: The Final Stroke

	WanderingImmortal: {
		DisplayName: The Azure-Clad Sword Immortal
		Arrive: The Azure-Clad Sword Immortal is drinking on a cloud nearby.
		Disturb: Don't bother me while I drink.
		Oh: Oh?
		Accept: Fine. A few strokes, then.
		Dismiss1: Go and train some more.
		Dismiss2: You don't know when to stop.
		Dismiss3: ...
		Leave: It's getting late.
		Gone: The Azure-Clad Sword Immortal has left.
	}
}

Items: {
	SwordImmortalBag: {
		DisplayName: Treasure Bag (The Azure-Clad Sword Immortal)
		Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
	}

	SwordImmortalTrophy: {
		DisplayName: Azure-Clad Sword Immortal Trophy
		Tooltip: ""
	}

	SwordImmortalRelic: {
		DisplayName: Azure-Clad Sword Immortal Relic
		Tooltip: ""
	}

	SwordImmortalHat: {
		DisplayName: The Immortal's Bamboo Hat
		Tooltip: ""
	}

	CloudweaveSilk: {
		DisplayName: Cloudweave Silk
		Tooltip: Used to craft the Wayfarer set
	}

	AzureWayfarerRobe: {
		DisplayName: Wayfarer's Robe
		Tooltip: 8% increased melee damage and critical strike chance
		SetBonus:
			'''
			Cloudstep: double-tap left or right to dash, briefly invincible as the dash starts
			Sword-Will: each sword hit adds a stack, up to 5; each stack gives 4% sword damage and 3% sword speed; stacks clear after 3 seconds without a hit
			With the Wayfarer's Jade Crown, gain Guarding Qi: after taking damage, 4 small swords circle you for 3 seconds, reducing damage taken by 25% and hurting enemies they touch; 20 second cooldown
			'''
	}

	AzureWayfarerCrown: {
		DisplayName: Wayfarer's Jade Crown
		Tooltip:
			'''
			6% increased melee critical strike chance
			Grants Guarding Qi when worn with the Wayfarer's Robe and Cloudstriders
			'''
	}

	AzureWayfarerBoots: {
		DisplayName: Wayfarer's Cloudstriders
		Tooltip: 10% increased movement speed and melee speed
	}

	InkwakeTassel: {
		DisplayName: Inkwake Tassel
		Tooltip:
			'''
			15% increased damage and 10% increased critical strike chance with swords
			Sword critical hits leave an ink mark that bursts after 1 second for half the hit's damage
			'''
	}

	AzureCloudDraught: {
		DisplayName: Azure Cloud Draught
		Tooltip:
			'''
			Restores 200 life
			Grants Tipsy for 5 minutes
			'''
	}

	LitanyOfSwordflight: {
		DisplayName: Litany of Swordflight
		Tooltip: Summons a rideable cloud with unlimited flight and no fall damage
	}

	LingeringStreamTalisman: {
		DisplayName: Talisman of the Lingering Stream
		Tooltip:
			'''
			Releases a river of sword-qi toward the cursor that hits up to 12 enemies; 30% less damage to bosses
			Grants 1 second of invincibility on use, at most once every 6 seconds
			'''
	}

	Clearmoon: {
		DisplayName: Clearmoon
		Tooltip:
			'''
			Three-hit combo: a sweep and a rising cut each release a line of sword-qi; the third hit, a thrust, releases a long one, and enemies it hits are cut again 0.3 seconds later
			Right-click to throw the sword at the cursor; it strikes three times and returns, with a 2.5 second cooldown; you can't attack while it is away
			'''
	}

	CloudbrewGourd: {
		DisplayName: Cloudbrew Gourd
		RecipeCondition: After defeating the Azure-Clad Sword Immortal
		Tooltip:
			'''
			Summons the Azure-Clad Sword Immortal to fight; consumed on use
			Before hardmode, he only comes to drink, can't be fought, and the gourd isn't consumed
			'''
	}
}

