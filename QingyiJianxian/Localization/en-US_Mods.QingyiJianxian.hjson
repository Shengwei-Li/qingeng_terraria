	DismissQi.DisplayName: A Flick of the Sleeve
	WineBlade.DisplayName: Drunken Blades
	CalligraphyStroke.DisplayName: The Eight Strokes of Eternity
	ClearmoonSwing.DisplayName: Clearmoon
	ClearmoonQi.DisplayName: Crescent of Clearmoon
	GuardSword.DisplayName: Guarding Qi
}

Buffs: {
	Tipsy: {
		DisplayName: A Pleasant Tipple
		Description: Damage, defense, life regeneration and speed are increased
	}

	SwordWill: {
		DisplayName: Sword-Will
		Description: Sword damage and speed rise with each layer
	}

	WanderingCloudBuff: {
		DisplayName: Upon the Cloud
		Description: Thou walkest upon a cloud
	}
