		DisplayName: Tipsy
		Description: 10% increased damage, +8 defense, +2 life per second, 10% increased movement speed
	}

	Disarmed: {
		DisplayName: Disarmed
		Description: The Sword Immortal took Clearmoon; you can't use it this fight
	}

	SwordWill: {
		DisplayName: Sword-Will
		Description: Each stack gives 4% sword damage and 3% sword speed
	}

	WanderingCloudBuff: {
		DisplayName: Riding the Cloud
		Description: You are riding a cloud
	}
